# Supabase project (Project Settings → API). Required.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Required: the progress sync endpoint writes learner history with it after
# verifying the parent-child relationship. Never expose it to the browser (no
# NEXT_PUBLIC_ prefix) and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct Postgres connection used only by `npm run test:db` (SQL/RLS tests)
# and the local stack. Not read by the application.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
