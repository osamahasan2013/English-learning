{
  "name": "english-learning-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/db/run-sql-tests.sh",
    "e2e": "playwright test",
    "content:import": "tsx --env-file-if-exists=.env.local scripts/content/import.mts",
    "db:types": "node scripts/db/gen-types.mjs",
    "stack:start": "bash scripts/local-stack/start.sh",
    "stack:stop": "bash scripts/local-stack/stop.sh"
  },
  "dependencies": {
    "@serwist/cli": "^9.5.12",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "dexie": "^4.2.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
